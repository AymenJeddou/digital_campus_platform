DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_campus
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Connect /chat to the AI pipeline (module:function)
RAG_PIPELINE_HANDLER=ai.integration:answer_chat

# Local/dev only: auto-verify new accounts so login works without SMTP.
# Keep this OUT of production (leave unset / false).
AUTO_VERIFY_EMAIL=true

# Frontend origin allowed by CORS.
FRONTEND_URL=http://localhost:3000

# Redis, used for the /auth/login rate limiter. If unreachable the limiter
# fails open (login still works) but brute-force protection is off.
REDIS_URL=redis://localhost:6379

# Google Classroom OAuth (courses feature). Leave the client id/secret empty to
# disable the integration; the manual course path still works without them.
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:8000/courses/classroom/callback
# Fernet key that encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=