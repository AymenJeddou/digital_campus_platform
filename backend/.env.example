# docker-compose.yml publishes Postgres on 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/digital_campus
# Signs every login token. Generate one per environment and never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
# Session length in minutes (the token lives in an httpOnly cookie).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Outgoing mail for verification and password-reset links. Leave SMTP_HOST
# empty in development (and keep AUTO_VERIFY_EMAIL=true below).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Connect /chat to the AI pipeline (module:function)
RAG_PIPELINE_HANDLER=ai.integration:answer_chat

# Local/dev only: auto-verify new accounts so login works without SMTP.
# Keep this OUT of production (leave unset / false).
AUTO_VERIFY_EMAIL=true

# Public URL of the frontend: used in email links and OAuth redirects (and
# CORS, though the app itself calls the API through the Next.js proxy).
FRONTEND_URL=http://localhost:3000

# Redis backs the rate limits (login, chat, password reset). If unreachable
# the limiter fails open (requests still work) but the protection is off.
REDIS_URL=redis://localhost:6379

# Google Classroom OAuth (courses feature). Leave the client id/secret empty to
# disable the integration; the manual course path still works without them.
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:8000/courses/classroom/callback
# Fernet key that encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=