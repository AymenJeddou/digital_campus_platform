# Choose the LLM provider: "gemini" or "mistral"
LLM_PROVIDER=mistral

# Mistral (default provider) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
# Optional: override the generation model (default: mistral-medium-latest)
# MISTRAL_MODEL=mistral-medium-latest

# Gemini (fallback provider)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the generation model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Day 5 retrieval grader: drop chunks scoring below this cosine threshold.
# RETRIEVAL_SCORE_THRESHOLD=0.5

# Day 6 groundedness grader: model used as the (independent) judge.
# Defaults to the active provider's generation model if unset.
# GROUNDEDNESS_GRADER_MODEL=mistral-small-latest

# PostgreSQL + pgvector connection for semantic search (same DB as the backend).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_campus
